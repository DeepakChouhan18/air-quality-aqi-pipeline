# Copy this file to .env and fill in real values. Never commit .env itself.

# OpenAQ API (register free at https://explore.openaq.org/register)
OPENAQ_API_KEY=your_openaq_api_key_here

# Target study area
TARGET_CITY=Bengaluru
TARGET_LAT=12.9716
TARGET_LON=77.5946

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aqi_db
DB_USER=postgres
DB_PASSWORD=postgres
