# Copy this file to .env and fill in real values. Never commit .env itself.

# ── OpenAQ API (register free at https://explore.openaq.org/register) ────────
OPENAQ_API_KEY=your_openaq_api_key_here

# ── Target study area ─────────────────────────────────────────────────────────
TARGET_CITY=Bengaluru
TARGET_LAT=12.9716
TARGET_LON=77.5946

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aqi_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── Part 2: Backfill settings ─────────────────────────────────────────────────
# How many months of history to pull from Open-Meteo (min 12 for sufficient ML data)
BACKFILL_MONTHS=14

# ── Part 2: MLflow ────────────────────────────────────────────────────────────
# When running locally: http://localhost:5001
# When running in Docker: http://mlflow:5001
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_PORT=5001

# ── Part 2: FastAPI ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Part 2: Streamlit ─────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
# URL the Streamlit app uses to call the FastAPI service
API_URL=http://localhost:8000

# ── Part 2: Monitoring thresholds (optional — these are the defaults) ─────────
# Stale data: how many hours without new data before flagging
STALE_DATA_HOURS=48
# Missing rate: fraction of feature values allowed to be NaN
MISSING_RATE_THRESHOLD=0.20
# Drift: PSI threshold per feature
PSI_DRIFT_THRESHOLD=0.2
# Drift: KS test p-value threshold
KS_PVALUE_THRESHOLD=0.05
# Drift: how many features must be drifted to trigger retrain
DRIFT_FEATURE_COUNT_THRESHOLD=3
# Performance: RMSE degradation threshold (0.20 = 20% worse than baseline)
RMSE_DEGRADATION_THRESHOLD=0.20
# Scheduled retrain interval in days
RETRAIN_EVERY_DAYS=30
